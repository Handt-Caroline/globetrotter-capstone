# Copy this file to  backend/.env  and fill in the values you want.
# run.sh / run.bat load it automatically, so a key set here sticks between
# runs instead of only lasting for one terminal. .env itself is gitignored.

# --- Real street routing (optional) ---------------------------------------
# The map and each itinerary's page ask OpenRouteService for routes that
# follow real streets. Without a key the app falls back to a straight-line
# estimate and says so on screen - nothing breaks.
# Get a free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
